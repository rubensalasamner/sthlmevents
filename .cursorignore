# Secrets — do not index or let the agent read these.
# Also covered by .gitignore; listed here so intent is explicit for
# remote-chat / MCP use (summaries must never include real keys).
.env
.env.local
.env*.local
**/.env

# Key material / credential dumps if they ever land in the tree
**/*.pem
**/credentials.json
**/secrets.json

# Templates are safe and useful (Cursor's default ignore can hide `.env*`).
!.env.example
!**/.env.example
