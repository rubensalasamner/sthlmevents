# Copy to `.env` and fill in. `.env` is gitignored.

# Ticketmaster Discovery API (https://developer.ticketmaster.com/).
# The Discovery API uses the Consumer Key as `apikey`; the secret is OAuth2-only.
TICKETMASTER_API_KEY=
TICKETMASTER_API_SECRET=

# Evenemangskollen API v1 (https://evenemangskollen.se/api-docs).
# Create a key at Dashboard -> API-inställningar; sent as the `x-api-key` header.
# NOTE: as of 2026-09 the documented /api/v1 answers 503 from its CDN; the
# adapter instead uses the site's own Supabase REST endpoint, which needs only
# the public anon key below (it is embedded in every visitor's JS bundle).
EVENEMANGSKOLLEN_API_KEY=
EVENEMANGSKOLLEN_ANON_KEY=

# LLM categorization pass (optional). Refines category 'other' events via any
# OpenAI-compatible chat-completions API. Without a key the snapshot keeps
# keyword-based categories. CATEGORIZER_BASE_URL defaults to
# https://api.openai.com/v1; point it at e.g. https://api.groq.com/openai/v1
# for Groq or https://openrouter.ai/api/v1 for OpenRouter.
CATEGORIZER_API_KEY=
CATEGORIZER_BASE_URL=
CATEGORIZER_MODEL=

# Kulturbiljetter Events API v3 (https://kulturbiljetter.se/api/events/).
# Request a key from info@kulturbiljetter.se; sent as `Authorization: Token …`.
KULTURBILJETTER_API_KEY=
